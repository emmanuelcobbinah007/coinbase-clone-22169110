# Example env file for local development
# Set the backend root URL (no /api path). Vite reads variables prefixed with VITE_.
# Code will append /api/crypto, /api/auth, etc. as needed.
# Local development:
VITE_API_BASE=http://localhost:5000
# Production (Render, Vercel, etc.):
# VITE_API_BASE=https://ia-crypto-backend-22169110.onrender.com
# Dev server proxy (used by Vite dev server).
VITE_DEV_PROXY=http://localhost:5000
